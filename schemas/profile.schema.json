{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mikolaj92/splot/schemas/profile.schema.json",
  "title": "Splot Profile",
  "type": "object",
  "required": ["version", "id", "mode", "objective"],
  "properties": {
    "version": {"type": "integer"},
    "id": {"type": "string"},
    "mode": {"type": "string", "enum": ["select_one", "compose", "route", "regulate"]},
    "language": {"type": "string"},
    "objective": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "description": {"type": "string"}
      }
    },
    "waves": {"type": "array", "items": {"type": "object"}},
    "signals": {"type": "array", "items": {"type": "object"}},
    "constraints": {"type": "array", "items": {"type": "object"}},
    "decision": {"type": "object"},
    "stability": {"type": "object"},
    "uncertainty": {"type": "object"},
    "composition": {"type": "object"},
    "required_providers": {"type": "array", "items": {"type": "string"}},
    "sidecars": {"type": "array", "items": {"type": "string"}}
  }
}
