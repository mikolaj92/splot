{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mikolaj92/splot/schemas/decision_report.schema.json",
  "title": "Splot Decision Report",
  "type": "object",
  "required": [
    "splot_version",
    "profile_id",
    "profile_version",
    "profile_digest",
    "profile_schema_version",
    "report_schema_version",
    "input_digest",
    "round_id",
    "mode",
    "objective_id",
    "created_at",
    "decision",
    "evaluations",
    "evidence",
    "belief",
    "updated_state"
  ],
  "properties": {
    "splot_version": {"type": "string"},
    "profile_id": {"type": "string"},
    "profile_version": {"type": "integer"},
    "profile_digest": {"type": "string"},
    "profile_schema_version": {"type": "integer"},
    "report_schema_version": {"type": "integer"},
    "input_digest": {"type": "string"},
    "round_id": {"type": "string"},
    "mode": {"type": "string"},
    "objective_id": {"type": "string"},
    "created_at": {"type": "string"},
    "observations": {"type": "array"},
    "candidates": {"type": "array"},
    "evaluations": {"type": "array"},
    "evidence": {"type": "array"},
    "belief": {"type": "object"},
    "decision": {"type": "object"},
    "updated_state": {"type": "object"}
  }
}
